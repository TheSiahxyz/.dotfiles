{{- /* left side: replaces the old `statfmt` option */ -}}
{{with .Message -}}
    {{. -}}
{{else with .UserOptions.stat -}}
    {{/* set by the `on-select` command in lfrc (eza -ldg output) */ -}}
    {{. -}}
{{else with .Stat -}}
    {{.Permissions | printf "\033[36m%s\033[0m" -}}
    {{with $.Mode}} {{.}}{{end -}}
    {{with .LinkCount}} {{.}}{{end -}}
    {{with .User}} {{.}}{{end -}}
    {{with .Group}} {{.}}{{end -}}
    {{.Size | humanize | printf " %5s" -}}
    {{.ModTime | printf " %s" -}}
    {{with .Target}} -> {{.}}{{end -}}
{{end -}}

{{- /* right side: replaces the old `rulerfmt` option */ -}}
{{.SPACER -}}
{{with .Keys}}  {{.}}{{end -}}
{{with .Progress}}  {{join . " "}}{{end -}}
{{with .Cut}}  {{len . | printf "%s %d \033[0m" $.Options.cutfmt}}{{end -}}
{{with .Copy}}  {{len . | printf "%s %d \033[0m" $.Options.copyfmt}}{{end -}}
{{- /* selsize is published by ~/.config/lf/selsync (save-select in lfrc) */ -}}
{{with .Select}}  {{$.Options.selectfmt}}{{printf " %d" (len .)}}{{with $.UserOptions.selsize}}{{printf " %s" .}}{{end}} {{printf "\033[0m"}}{{end -}}
{{with .Visual}}  {{len . | printf "%s %d \033[0m" $.Options.visualfmt}}{{end -}}
{{with .Filter}}  {{join . " " | printf "\033[7;34m %s \033[0m"}}{{end -}}
{{printf "  %d/%d(%d) %s " .Index .Total .Hidden .ScrollPercentage -}}
{{df}}
