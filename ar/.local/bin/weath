#!/bin/sh
#
# Get the weather on the terminal. You can pass an alternative location as a parameter,
# and/or use the 'cp' option to copy the forecast as plaintext to the clipboard.

weatherreport="${XDG_CACHE_HOME:-${HOME}/.cache}/weatherreport"

# Show a report in a pager in its own terminal window. The pager shows however
# many days wttr.in put in the report; trimming to what fits only ever hid a day
# the pager could have scrolled to. $2 is a scratch file to delete once the
# pager exits, if any.
show() {
  # shellcheck disable=SC2016 # the positionals belong to the inner shell
  setsid -f "$TERMINAL" -e sh -c \
    'export LESS=R LESSOPEN=
     # Trap rather than a trailing rm: closing the window from the window
     # manager kills the terminal outright, and anything after the pager never
     # gets to run.
     [ -n "$2" ] && trap "rm -f \"$2\"" EXIT HUP INT TERM
     less -SR "$1"' \
    weath "$1" "$2" >/dev/null 2>&1
}

# Download a report to a file. Never route it through a command substitution:
# dash reserves byte 0x82 as an internal marker and escapes every occurrence,
# which corrupts '│' (U+2502) — the character wttr.in draws its table borders
# with — into a stray '━' followed by an invalid byte.
fetch() {
  curl -sfm 5 -o "$2" "${WTTRURL:-wttr.in}/$1"
}

scratch() {
  mktemp "${TMPDIR:-/tmp}/weath.XXXXXX"
}

if [ "$1" = 'cp' ]; then
  if [ -z "$2" ]; then
    sed 's/\x1b\[[^m]*m//g' "$weatherreport" | xclip -selection clipboard &&
      notify-send "Weather forecast for '${LOCATION:-$(head -n 1 "$weatherreport" | cut -d' ' -f3-)}' copied to clipboard."
  else
    tmp="$(scratch)"
    if fetch "$2?T" "$tmp"; then
      xclip -selection clipboard <"$tmp" &&
        notify-send "🌞Weather forecast for '$2' copied to clipboard."
    else
      notify-send '🥶Failed to get weather forecast!' 'Check your internet connection and the supplied location.'
    fi
    rm -f "$tmp"
  fi
else
  [ -n "$2" ] &&
    notify-send "⛔Invalid option '$1'! The only valid option is 'cp'." &&
    exit 1

  if [ -z "$1" ]; then
    show "$weatherreport" ''
  else
    tmp="$(scratch)"
    if fetch "$1" "$tmp"; then
      show "$tmp" "$tmp"
    else
      rm -f "$tmp"
      notify-send '❗Failed to get weather forecast!' 'Check your internet connection and the supplied location.'
    fi
  fi
fi
