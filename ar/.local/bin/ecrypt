#!/bin/sh

mount_encrypted() {
  echo "$passphrase" | sudo mount -t ecryptfs "$1" "$2" \
    -o ecryptfs_cipher=aes,ecryptfs_key_bytes=32,ecryptfs_passthrough=no,ecryptfs_enable_filename_crypto=yes,ecryptfs_sig=$ecryptfs_sig,ecryptfs_fnek_sig=$fnek_sig,key=passphrase:passphrase_passwd=$(printf '%s' "$passphrase")
}

is_mounted() {
  mount | grep -q " $1 "
}

lock() {
  if sudo umount "$1"; then
    notify-send "🔒 Locked: $2"
  else
    notify-send "❗ Unable to lock" "Mounted: $2"
  fi
}

unlock() {
  ecryptfs_sig=$(pass show encryption/ecryptfs-sig-"$4")
  fnek_sig=$ecryptfs_sig
  passphrase=$(pass show encryption/ecryptfs)
  [ -z "$passphrase" ] && {
    notify-send "❌ Failed to retrieve passphrase."
    exit 1
  }
  mount_encrypted "$1" "$2" && notify-send "🔑 Unlocked: $3"
}

# target:mountpoint:sig (one per line)
entries="$HOME/.secret:$HOME/Secret:default
/media/si/thesiahxyz:$HOME/SecretUSB:default"

# Keep only targets that are available (drives plugged in)
available=""
while IFS=: read -r target mp sig; do
  case "$target" in
  /media/* | /mnt/*) [ -n "$(ls -A "$target" 2>/dev/null)" ] || continue ;;
  *) [ -d "$target" ] || mkdir -p "$target" ;;
  esac
  [ -d "$mp" ] || mkdir -p "$mp"
  available="$available$target:$mp:$sig
"
done <<EOF
$entries
EOF

# Lock everything only when all available targets are unlocked;
# otherwise unlock the remaining ones so the states never diverge.
all_mounted=1
while IFS=: read -r target mp sig; do
  [ -n "$target" ] || continue
  is_mounted "$mp" || all_mounted=0
done <<EOF
$available
EOF

while IFS=: read -r target mp sig; do
  [ -n "$target" ] || continue
  name=$(basename "$mp")
  if [ "$all_mounted" -eq 1 ]; then
    lock "$mp" "$name"
  elif ! is_mounted "$mp"; then
    unlock "$target" "$mp" "$name" "$sig"
  fi
done <<EOF
$available
EOF

pkill -RTMIN+1 dwmblocks
