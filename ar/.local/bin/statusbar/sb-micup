#!/bin/sh

# Updates the mic statusbar module when audio sources change
# (e.g. bluetooth/usb device connect/disconnect, mute changed outside dwm)

signal() { pkill -RTMIN+5 "${STATUSBAR:-dwmblocks}" 2>/dev/null; }

pactl subscribe 2>/dev/null | while read -r line; do
  case "$line" in
  *" on source #"* | *" on card #"* | *" on server"*) signal ;;
  esac
done
