#!/bin/sh

# Single instance: sb-volume/sb-mic (or concurrent runs) may race past pidof.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/sb-mpdup.lock"
flock -n 9 || exit 0

# This loop will update the mpd statusbar module whenever a command changes the
# music player's status. mpd must be running on X's start for this to work.

MPD_HOST="${MPD_HOST:-/tmp/mpd_socket}"
export MPD_HOST

# 9>&-: mpc must not inherit the lock. If this shell is killed, the blocked
# `mpc idle` lives on until the next mpd event, and while it held the lock
# every restart exited at flock above.
# sleep: with mpd down `mpc idle` fails at once, which would spin this loop.
while :; do
  mpc idle >/dev/null 9>&- || {
    sleep 1 9>&-
    continue
  }
  kill -60 $(pidof "${STATUSBAR:-dwmblocks}") 2>/dev/null
done
