#!/bin/sh

# Displays new nginx log entries from ylog.
# Updates every 30 minutes via dwmblocks.
# Left click: show all current entries
# Middle click: show new entries and mark as seen
# Right click: help

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ylog_sb"
PREV="$CACHE_DIR/prev"
CURR="$CACHE_DIR/curr"
NEW="$CACHE_DIR/new"
LOCK="$CACHE_DIR/lock"

mkdir -p "$CACHE_DIR"

export SSH_AUTH_SOCK="/run/user/$(id -u)/gnupg/S.gpg-agent.ssh"

BOT_UA_KEYWORDS='bot|spider|crawler|crawl|slurp|scrapy|censys|shodan|zgrab|masscan|nmap|netcraft|expanse|internetmeasurement|paloaltonetworks|checker|monitor|uptime|pingdom|statuscake|site24x7|headlesschrome|phantomjs|puppeteer|playwright|selenium|go-http-client|python-requests|python-urllib|libwww-perl|java/|apache-httpclient|guzzlehttp|okhttp|node-fetch|axios|aiohttp|httpx|postmanruntime|insomnia|curl/|wget/|facebookexternalhit|meta-externalagent|semrush|ahrefs|rootevidence|thesiah-|logrotate-'
BOT_UA_RE="(\"[^\"]*(${BOT_UA_KEYWORDS})[^\"]*\"|\"-\"|\"Mozilla/5\.0\"|\"\")\$"

SCAN_PATH_RE='"[A-Z]+ [^"]*(\.php|\.asp|\.jsp|wp-admin|wp-content|wp-includes|wp-login|wlwmanifest|xmlrpc|/\.(env|git|aws|ssh|svn|vscode)|phpmyadmin|/cgi-bin/|/boaform|/hnap1|/autodiscover|/owa/|/telescope/|/actuator|/solr/|/druid/|/geoserver|/_ignition|/eval-stdin|/shell|\.sql|\.bak)'

ASSET_PATH_RE='"[A-Z]+ [^" ?]*\.(js|mjs|css|map|json|xml|txt|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|otf|eot|mp4|m4s|m3u8|webm)([?" ]|$)'

RENDER_ASSET_RE='"[A-Z]+ [^" ?]*\.(js|mjs|css|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|otf|eot|mp3|mp4|m4s|m3u8|webm)([?" ]|$)'

PAGEVIEW_STATUS_RE='HTTP/[0-9.]+" (200|206|304) '

# Opening a URL and leaving without logging in leaves only an auth prompt (401)
# or a redirect, with no CSS/JS. Browsers reach us over TLS as HTTP/2+, while
# nearly all scanners speak HTTP/1.1, so the protocol separates the two.
BOUNCE_RE='"GET [^"]* HTTP/[23](\.0)?" (401|30[1-8]) '

CHROME_MIN=130
FIREFOX_MIN=125

# Keep real page views of visitors whose browser loaded CSS/JS, plus bounce
# landings of visitors who never got that far.
keep_visits() {
  RENDER_ASSET_RE="$RENDER_ASSET_RE" ASSET_PATH_RE="$ASSET_PATH_RE" \
    PAGEVIEW_STATUS_RE="$PAGEVIEW_STATUS_RE" BOUNCE_RE="$BOUNCE_RE" awk '
    BEGIN {
      render = ENVIRON["RENDER_ASSET_RE"]; asset = tolower(ENVIRON["ASSET_PATH_RE"])
      view = ENVIRON["PAGEVIEW_STATUS_RE"]; bounce = ENVIRON["BOUNCE_RE"]
    }
    { line[NR] = $0; owner[NR] = $1; if ($0 ~ render) rendered[$1] = 1 }
    END {
      for (i = 1; i <= NR; i++) {
        if (tolower(line[i]) ~ asset) continue
        if (owner[i] in rendered) { if (line[i] ~ view) print line[i] }
        else if (line[i] ~ bounce) print line[i]
      }
    }
  '
}

drop_implausible_ua() {
  awk -v cmin="$CHROME_MIN" -v fmin="$FIREFOX_MIN" '
    {
      ua = $0
      sub(/^.*" "/, "", ua)
      sub(/"$/, "", ua)

      if (ua ~ /Chrome\//) {
        if (ua !~ /AppleWebKit\/537\.36 \(KHTML, like Gecko\)/) next
        if (ua !~ /Safari\/537\.36/) next
      }

      derived = (ua ~ /(SamsungBrowser|Edge?A?|EdgiOS|OPR|Opera|Whale|YaBrowser|Vivaldi|Brave|CriOS|FxiOS)\//)

      if (!derived && match(ua, /Chrome\/[0-9]+/) &&
          substr(ua, RSTART + 7, RLENGTH - 7) + 0 < cmin) next
      if (!derived && match(ua, /Firefox\/[0-9]+/) &&
          substr(ua, RSTART + 8, RLENGTH - 8) + 0 < fmin) next

      # iOS Safari: Version/ major tracks the OS major. Safari 26+ freezes the
      # OS token at a two-part 18_x, so a patch-level 18_x_y with Version/26 is forged.
      if (!derived && match(ua, /OS [0-9_]+ like Mac OS X/) &&
          match(ua, /Version\/[0-9]+/)) {
        vmaj = substr(ua, RSTART + 8, RLENGTH - 8) + 0
        match(ua, /OS [0-9_]+ like/)
        nos = split(substr(ua, RSTART + 3, RLENGTH - 8), os, "_")
        if (vmaj >= 26) {
          if (os[1] != vmaj && !(os[1] == 18 && nos == 2)) next
        } else if (os[1] != vmaj) next
      }

      print
    }
  '
}

fetch_logs() {
  kr_today=$(TZ=Asia/Seoul LC_TIME=C date +%d/%b)
  kr_yesterday=$(TZ=Asia/Seoul LC_TIME=C date -d 'yesterday' +%d/%b)
  ssh -o BatchMode=yes -o ConnectTimeout=10 root@thesiah.xyz \
    "cat /var/log/nginx/diary/us.log /var/log/nginx/diary/kr.log \
         /var/log/nginx/media/us.log /var/log/nginx/media/kr.log \
         /var/log/nginx/peertube/us.log /var/log/nginx/peertube/kr.log \
         /var/log/nginx/recordings/us.log /var/log/nginx/recordings/kr.log 2>/dev/null" \
    2>/dev/null | grep -E "$kr_today|$kr_yesterday" | grep -E '[0-9]{2}:[0-9]{2}:[0-9]{2} ' |
    grep -vE '^(59\.19\.56\.8|2a02:4780:10:212c::1) ' |
    grep -vE '^[0-9a-fA-F:]+:: ' |
    grep -viE "$BOT_UA_RE" | grep -viE "$SCAN_PATH_RE" |
    keep_visits | drop_implausible_ua | sort -u
}

update() {
  if [ -f "$LOCK" ]; then
    kill -0 "$(cat "$LOCK")" 2>/dev/null && return
  fi
  echo $$ >"$LOCK"

  fetch_logs >"$CURR" 2>/dev/null
  total=$(wc -l <"$CURR")

  if [ -f "$PREV" ]; then
    comm -23 "$CURR" "$PREV" >"$NEW"
  else
    cp "$CURR" "$NEW"
  fi

  new_count=$(wc -l <"$NEW")
  [ -t 1 ] && echo "[ylog] fetched $total lines, $new_count new" >&2

  rm -f "$LOCK"
}

mark_seen() {
  [ -f "$CURR" ] && cp "$CURR" "$PREV"
  : >"$NEW"
}

case $BLOCK_BUTTON in
1)
  if [ -s "$NEW" ]; then
    count=$(wc -l <"$NEW")
    notify-send "🌐 Current log entries ($count)" "$(cut -c1-120 "$NEW" | tail -20)"
  else
    notify-send "🌐 Ylog" "No entries in cache."
  fi
  ;;
2)
  if [ -s "$NEW" ]; then
    mark_seen
    pkill -RTMIN+21 "${STATUSBAR:-dwmblocks}"
  else
    notify-send "🌐 Ylog" "No new entries."
  fi
  ;;
3)
  notify-send "🌐 Ylog module" "\- Shows new nginx log entries (diary/media/peertube/recordings, US+KR)
- Bots, vuln scanners & spoofed browser UAs are filtered out
- Page views count only if the browser loaded CSS/JS (drops headless scanners)
- Visits that just opened the URL (login prompt/redirect, HTTP/2) also count
- Updates every 30 minutes
- Left click: show all current entries
- Middle click: show new entries & mark seen"
  ;;
6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
*)
  update
  ;;
esac

if [ -s "$NEW" ]; then
  count=$(wc -l <"$NEW")
  printf "🍞%s\n" "$count"
fi

exit 0
