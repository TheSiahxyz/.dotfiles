#!/bin/bash

# Usage
#   sb-ticker
# Sample output
#   📈0.09%     (first ticker is up)
#   📉-1.88%    (first ticker is down)
# Description
#   displays/retrieves the latest percent-change in stock market quotes listed in $XDG_CONFIG_HOME/tickers.
#       defaults to S&P 500, Dow Jones Industrial, and the Nasdaq
#
#   intended to be used in the statusbar, which will display the first quote price in the output

url="terminal-stocks.dev"
pricefile="${XDG_CACHE_HOME:-$HOME/.cache}/stock-prices"
tickerfile="${XDG_CONFIG_HOME:-$HOME/.config}/tickers"

[ -f "$tickerfile" ] && tickers="$(cat "$tickerfile")" || tickers="^GSPC,^DJI,^IXIC"

# True when the cache needs fetching: missing, empty, or from an earlier hour.
checkprice() {
  [ ! -s "$pricefile" ] || [ "$(stat -c %y "$pricefile" 2>/dev/null |
    cut -d':' -f1)" != "$(date '+%Y-%m-%d %H')" ]
}

getchange() {
  mapfile -t changes < <(sed -e 's/  / /g' "$pricefile" | grep -oe '[m-]\+[0-9]\+\.[0-9]\+' | sed 's/[m ]/;/g')
  IFS=',' read -ra ticker <<<"$tickers"
  for idx in "${!ticker[@]}"; do
    printf "%s: %s%%\n" "${ticker[$idx]}" "${changes[$idx]//;/}"
  done
}

# The site redirects http to https, hence -L. Download to a scratch file so a
# failed fetch leaves the previous prices in place.
# One unknown symbol makes the site answer 200 with an apology instead of the
# table, for every ticker in the request - so require the table header before
# accepting the download.
updateprice() {
  curl -sfLm 10 "https://$url/$tickers" --output "$pricefile.part" &&
    grep -q 'Stock Name' "$pricefile.part" &&
    mv -f "$pricefile.part" "$pricefile" && return 0
  rm -f "$pricefile.part"
  return 1
}

case $BLOCK_BUTTON in
1) setsid "$TERMINAL" -e less -Srf "$pricefile" ;;
2)
  notify-send -u low "Updating..." "Updating prices"
  updateme="1"
  ;;
3) notify-send "Current prices:" "Current stock prices:\n<b>$(getchange)</b>

LEFT MOUSE BUTTON: show price file
MIDDLE MOUSE BUTTON: update stock prices
RIGHT MOUSE BUTTON: Get stock overview" ;;
6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Fetch before printing, so a refresh shows up in this run's output.
# A failed fetch is flagged with ❗ rather than passed off as current: the value
# shown next to it is then whatever the last successful fetch left behind.
stale=""
if [ -n "$updateme" ] || checkprice; then
  updateprice || stale="❗"
fi

# The bar gets one line: the first ticker's change, 📈 when up and 📉 when down.
# The symbol name is left to the right-click notification.
first=""
if [ -s "$pricefile" ]; then
  first="$(getchange | head -n1)"
  first="${first#*: }"
fi
case "$first" in
"%" | "") [ -n "$stale" ] && printf '📊%s\n' "$stale" ;; # nothing to show
-*) printf '📉%s%s\n' "$first" "$stale" ;;
*) printf '📈%s%s\n' "$first" "$stale" ;;
esac
exit 0
