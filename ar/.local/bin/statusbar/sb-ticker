#!/bin/bash

# Usage
#   sb-ticker
# Sample output
#   📈0.09%     (first ticker is up)
#   📉-1.88%    (first ticker is down)
# Description
#   displays/retrieves the latest percent-change in stock market quotes listed in $XDG_CONFIG_HOME/tickers.
#       defaults to S&P 500, Dow Jones Industrial, and the Nasdaq
#
#   intended to be used in the statusbar, which will display the first quote price in the output

url="terminal-stocks.dev"
pricefile="${XDG_CACHE_HOME:-$HOME/.cache}/stock-prices"
tickerfile="${XDG_CONFIG_HOME:-$HOME/.config}/tickers"

[ -f "$tickerfile" ] && tickers="$(cat "$tickerfile")" || tickers="^GSPC,^DJI,^IXIC"

# True when the cache needs fetching: missing, empty, or from an earlier hour.
checkprice() {
  [ ! -s "$pricefile" ] || [ "$(stat -c %y "$pricefile" 2>/dev/null |
    cut -d':' -f1)" != "$(date '+%Y-%m-%d %H')" ]
}

getchange() {
  mapfile -t changes < <(sed -e 's/  / /g' "$pricefile" | grep -oe '[m-]\+[0-9]\+\.[0-9]\+' | sed 's/[m ]/;/g')
  IFS=',' read -ra ticker <<<"$tickers"
  for idx in "${!ticker[@]}"; do
    printf "%s: %s%%\n" "${ticker[$idx]}" "${changes[$idx]//;/}"
  done
}

# The site redirects http to https, hence -L. Download to a scratch file so a
# failed fetch leaves the previous prices in place.
# One unknown symbol makes the site answer 200 with an apology instead of the
# table, for every ticker in the request - so require the table header before
# accepting the download.
updateprice() {
  curl -sfLm 10 "https://$url/$tickers" --output "$pricefile.part" &&
    grep -q 'Stock Name' "$pricefile.part" &&
    mv -f "$pricefile.part" "$pricefile" && return 0
  rm -f "$pricefile.part"
  return 1
}

# Print the cached table fitted to a terminal $1 columns wide.
#
# The site rules off every row and appends blank lines and adverts, which
# roughly doubles the height, so only the rule under the header survives. The
# table is 121 columns - more than even a full-screen terminal has here - so it
# is cut after the last whole column that fits, dropping the ranges on the
# right before anything else. Colour codes take no room and are copied through.
#
# The site also puts "$" in front of every price whatever it is priced in, so a
# Samsung share reads "$208,000.00". Rows come back in the order the tickers
# were asked for, which lets the symbol say what the sign should be: won for the
# Korean exchanges, the quote currency for an exchange rate (the three letters
# before "=X"), a trailing "%" for the Treasury yield indices, nothing for other
# indices and foreign listings (points, or a currency this cannot tell), and
# the dollar left alone for the rest.
fittable() {
  awk -v width="$1" -v tickers="$tickers" '
    function currency(t,    quote) {
      if (t ~ /^\^(IRX|FVX|TNX|TYX)$/) return "%"
      if (t ~ /=X$/) {
        quote = substr(t, length(t) - 4, 3)
        return quote in money ? money[quote] : ""
      }
      if (t ~ /\.K[SQ]$|-KRW$/) return "₩"
      if (t ~ /^\^|\./) return ""
      return "$"
    }
    BEGIN {
      split(tickers, ticker, ",")
      money["KRW"] = "₩"; money["USD"] = "$"; money["EUR"] = "€"
      money["GBP"] = "£"; money["JPY"] = "¥"; money["CNY"] = "¥"
    }
    { plain = $0; gsub(/\033\[[0-9;]*m/, "", plain) }
    plain ~ /^[[:space:]]*$/ { next }
    plain ~ /TIP:|DISCLAIMER|twitter:/ { next }
    plain ~ /^├/ { if (rules++) next }
    plain ~ /^│/ && rows++ { # every row after the header, in ticker order
      sign = currency(ticker[rows - 1])
      if (sign == "%") {
        # The sign moves from the front of each number to the back: same width.
        $0 = gensub(/\$([0-9][0-9.,]*)/, "\\1%", "g")
      } else if (sign != "" && sign != "$") {
        gsub(/\$/, sign)
      } else if (sign == "") {
        # Dropping the sign narrows the cell; pad it back so the borders line up.
        cells = split($0, cell, "│"); $0 = ""
        for (c = 1; c <= cells; c++) {
          gone = gsub(/\$/, "", cell[c])
          $0 = $0 (c > 1 ? "│" : "") cell[c] sprintf("%*s", gone, "")
        }
      }
      plain = $0; gsub(/\033\[[0-9;]*m/, "", plain)
    }
    plain ~ /^┌/ && length(plain) > width {
      for (i = 2; i <= width; i++)
        if (substr(plain, i, 1) == "┬") cut = i
    }
    cut && plain ~ /^[┌├└│]/ {
      edge = substr(plain, 1, 1)
      edge = edge == "┌" ? "┐" : edge == "├" ? "┤" : edge == "└" ? "┘" : "│"
      out = ""; rest = $0
      for (n = 1; n < cut && rest != "";) {
        if (match(rest, /^\033\[[0-9;]*m/)) {
          out = out substr(rest, 1, RLENGTH); rest = substr(rest, RLENGTH + 1)
        } else {
          out = out substr(rest, 1, 1); rest = substr(rest, 2); n++
        }
      }
      print out edge
      next
    }
    { print }
  ' "$pricefile"
}

# What the left click runs inside the window it opens: the table in a pager,
# re-fitted whenever the window changes width. q closes it.
#
# Fitting once is not enough: st starts the shell at its own default size (62
# columns here) and dwm tiles the window afterwards - a few milliseconds later,
# or not until the tag is viewed if the window opened on a hidden one. less
# repaints on a resize but cannot re-cut the columns, so a watcher restarts it
# with a freshly fitted table. less gets -R, not -r: with -r it cannot measure a
# line and wraps the table.
if [ "$1" = "--view" ]; then
  view="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/sb-ticker.XXXXXX")"
  trap 'rm -f "$view" "$view.resized"' EXIT
  trap 'exit 0' HUP INT TERM
  while :; do
    cols="$(tput cols)"
    fittable "$cols" >"$view"
    (
      while [ "$(tput cols)" = "$cols" ]; do sleep 0.2; done
      : >"$view.resized"
      pkill -P $$ -x less
    ) &
    watcher=$!
    LESS='' LESSOPEN='' less -SR "$view"
    kill "$watcher" 2>/dev/null
    [ -e "$view.resized" ] || break # less was quit, not restarted
    rm -f "$view.resized"
  done
  exit 0
fi

case $BLOCK_BUTTON in
1) [ -s "$pricefile" ] && setsid -f "$TERMINAL" -e "$0" --view ;;
2)
  notify-send -u low "Updating..." "Updating prices"
  updateme="1"
  ;;
3) notify-send "Current prices:" "Current stock prices:\n<b>$(getchange)</b>

LEFT MOUSE BUTTON: show price file
MIDDLE MOUSE BUTTON: update stock prices
RIGHT MOUSE BUTTON: Get stock overview" ;;
6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Fetch before printing, so a refresh shows up in this run's output.
# A failed fetch is flagged with ❗ rather than passed off as current: the value
# shown next to it is then whatever the last successful fetch left behind.
stale=""
if [ -n "$updateme" ] || checkprice; then
  updateprice || stale="❗"
fi

# The bar gets one line: the first ticker's change, 📈 when up and 📉 when down.
# The symbol name is left to the right-click notification.
first=""
if [ -s "$pricefile" ]; then
  first="$(getchange | head -n1)"
  first="${first#*: }"
fi
case "$first" in
"%" | "") [ -n "$stale" ] && printf '📊%s\n' "$stale" ;; # nothing to show
-*) printf '📉%s%s\n' "$first" "$stale" ;;
*) printf '📈%s%s\n' "$first" "$stale" ;;
esac
exit 0
