#!/bin/sh

# Prints the current volume, 🔇 if muted or 🚫 if there is no real output device.

case $BLOCK_BUTTON in
1)
  setsid -w -f "$TERMINAL" -e pulsemixer
  pkill -RTMIN+4 "${STATUSBAR:-dwmblocks}"
  ;;
2) wpctl set-mute @DEFAULT_SINK@ toggle ;;
3) notify-send "📢 Volume module" "\- Shows volume 🔊, 🔇 if muted, 🚫 if no output device
- Middle click to mute
- Scroll to change" ;;
4) wpctl set-volume @DEFAULT_SINK@ 1%+ ;;
5) wpctl set-volume @DEFAULT_SINK@ 1%- ;;
6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

pidof -x sb-audioup >/dev/null 2>&1 || sb-audioup >/dev/null 2>&1 &

vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"

# Without any usable output, pipewire falls back to the virtual "Dummy Output"
# sink, whose volume is meaningless. Print 🚫 for that and for no sink at all.
sink="$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
case "$vol$sink" in
"" | *'factory.name = "support.null-audio-sink"'*) echo 🚫 && exit ;;
esac

# If muted, print 🔇 and exit.
[ "$vol" != "${vol%\[MUTED\]}" ] && {
  printf "🔇\n"
  exit
}

vol="$(
  IFS=.
  set -- ${vol#Volume: }
  printf "%.0f" "$1$2"
)"

case 1 in
$((vol > 100))) icon="📢" ;;
$((vol >= 70))) icon="🔊" ;;
$((vol >= 30))) icon="🔉" ;;
$((vol >= 1))) icon="🔈" ;;
*)
  printf "🔇\n"
  exit
  ;;
esac

printf "%s%d%%\n" "$icon" "$vol"
