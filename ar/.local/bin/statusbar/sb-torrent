#!/bin/sh

case $BLOCK_BUTTON in
1) setsid -f "$TERMINAL" -e stig ;;
2) td-toggle ;;
3) notify-send "🌱 Torrent module" "\- Left click to open stig
- Middle click to toggle transmission
- Shift click to edit script
Module shows number of torrents:
🛑: paused
🕰: idle (seeds needed)
🧲: waiting for magnet metadata
🔼: uploading (unfinished)
🔽: downloading (receiving data)
✅: done
🌱: done and seeding" ;;
6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Counts match what stig reports: a torrent is downloading/uploading when it is
# actually moving data, not merely when transmission says it would like to.
transmission-remote -l | awk '
  # Column positions shift ("Have" may be "None", "ETA" may be "22 hrs"), so
  # anchor on the status keyword: Up, Down and Ratio always precede it.
  function status_field(   i) {
    for (i = 3; i <= NF; i++)
      if ($i ~ /^(Stopped|Idle|Downloading|Seeding|Uploading|Verifying|Checking|Finished|Queued|Up)$/)
        return i
    return 0
  }

  NR == 1 || /^Sum:/ { next }

  {
    s = status_field()
    if (!s)
      next
    status = $s
    up = $(s - 3) + 0
    down = $(s - 2) + 0
    progress = $2

    if (status == "Stopped")
      stopped++
    else if (progress == "n/a")
      magnet++
    else if (status == "Seeding")
      seeding++
    else if (progress == "100%")
      complete++
    else if (down > 0)
      download++
    else if (up > 0)
      upload++
    else
      idle++
  }

  END {
    if (stopped)  out = out " 🛑" stopped
    if (idle)     out = out " 🕰" idle
    if (magnet)   out = out " 🧲" magnet
    if (upload)   out = out " 🔼" upload
    if (download) out = out " 🔽" download
    if (complete) out = out " ✅" complete
    if (seeding)  out = out " 🌱" seeding
    sub(/^ /, "", out)
    print out
  }
'
