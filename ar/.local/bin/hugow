#!/bin/sh
set -eu

repodir="$HOME/Private/repos/diary"
out="$repodir/public/index.html"
server="${THESIAH_SERVER:-root@thesiah.xyz}"
dest="/var/www/diary/"
src="$repodir/public/"

cd "$repodir"
hugo --cleanDestinationDir

if [ ! -f "$out" ]; then
  echo "error: not found: $out (hugo build produced no homepage)" >&2
  exit 1
fi

ssh "$server" "mkdir -p '$dest'"

# Sync the whole built site to the web root. No --delete: files already on
# the server are never removed, only added or updated.
if [ -n "${THESIAH_SSH_OPTS:-}" ]; then
  rsync -azv --update --itemize-changes --stats \
    -e "ssh $THESIAH_SSH_OPTS" \
    "$src" "$server:$dest"
else
  rsync -azv --update --itemize-changes --stats \
    "$src" "$server:$dest"
fi

ssh "$server" "find '$dest' -name index.html -type f -exec chmod 644 {} +"

cd - >/dev/null
