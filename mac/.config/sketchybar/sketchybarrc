#!/usr/bin/env bash

# SketchyBar with AeroSpace integration.
# Colors and icons live in separate files; every script is in plugins/.
#
# Rules this config follows (each one fixed a real bug):
#   - an item whose script must run while it is hidden needs updates=on
#   - popup items are created once here, never from a click script
#   - nothing polls faster than it has to; prefer events over update_freq

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top height=42 \
  color=$BAR_COLOR \
  border_width=0 \
  corner_radius=0 \
  margin=0 \
  blur_radius=0 \
  padding_left=16 \
  padding_right=16 \
  shadow=off \
  sticky=on \
  topmost=window

##### Changing Defaults #####
default=(
  updates=when_shown
  icon.font="SF Pro:Semibold:15.0"
  icon.color=$ICON_COLOR
  icon.padding_left=6
  icon.padding_right=6
  label.font="SF Pro:Semibold:13.0"
  label.color=$LABEL_COLOR
  label.padding_left=6
  label.padding_right=6
  padding_left=8
  padding_right=8
  background.height=26
  background.corner_radius=6
  background.border_width=1
  background.border_color=$BACKGROUND_2
  popup.background.border_width=2
  popup.background.corner_radius=6
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
)

sketchybar --default "${default[@]}"

##### Custom Events #####
sketchybar --add event aerospace_workspace_change \
  --add event aerospace_mode_change \
  --add event input_change AppleSelectedInputSourcesChangedNotification

# popup_item <parent> <name> <icon> <icon color> <label> <command>
# A popup row that runs <command> and closes the popup.
popup_item() {
  sketchybar --add item "$2" "popup.$1" \
    --set "$2" icon="$3" \
    icon.color="$4" \
    label="$5" \
    background.drawing=off \
    click_script="$6; sketchybar --set $1 popup.drawing=off"
}

##### Left Side Items #####

# Apple Logo (click: menu, mouse leaves the bar: close)
sketchybar --add item apple.logo left \
  --set apple.logo icon=$APPLE \
  icon.font="SF Pro:Black:16.0" \
  icon.color=$ACCENT_SECONDARY \
  padding_right=12 \
  padding_left=4 \
  label.drawing=off \
  click_script="sketchybar --set apple.logo popup.drawing=toggle" \
  script="sketchybar --set apple.logo popup.drawing=off" \
  --subscribe apple.logo mouse.exited.global

popup_item apple.logo apple.prefs "󰒓" $BLUE "System Settings" "open -a 'System Settings'"
popup_item apple.logo apple.activity "󰖚" $GREEN "Activity Monitor" "open -a 'Activity Monitor'"
popup_item apple.logo apple.lock "󰌾" $RED "Lock Screen" "pmset displaysleepnow"
popup_item apple.logo apple.sleep "󰤄" $YELLOW "Sleep" "pmset sleepnow"

# AeroSpace workspaces: one chip per monitor (ws.1 .. ws.3). The script runs on
# ws.1 only and fills in every chip; see plugins/aerospace.sh.
for i in 1 2 3; do
  sketchybar --add item ws.$i left \
    --set ws.$i drawing=off \
    icon.font="SF Pro:Semibold:12.0" \
    icon.color=$GREY \
    icon.align=center \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.drawing=off \
    padding_left=4 \
    padding_right=4 \
    background.color=$BACKGROUND_1 \
    background.corner_radius=6 \
    background.height=26 \
    background.drawing=on
done

sketchybar --set ws.1 updates=on script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe ws.1 aerospace_workspace_change display_change system_woke

# AeroSpace binding mode (only drawn while a chord is pending, hence updates=on)
sketchybar --add item mode left \
  --set mode drawing=off \
  updates=on \
  icon.drawing=off \
  label.font="SF Pro:Semibold:12.0" \
  label.color=$BLACK \
  label.padding_left=8 \
  label.padding_right=8 \
  padding_left=4 \
  padding_right=4 \
  background.color=$YELLOW \
  background.border_width=0 \
  background.drawing=on \
  script="$PLUGIN_DIR/aerospace_mode.sh" \
  --subscribe mode aerospace_mode_change

# Separator
sketchybar --add item separator left \
  --set separator icon="󰇙" \
  icon.font="SF Pro:Regular:16.0" \
  icon.color=$ACCENT_TERTIARY \
  padding_left=12 \
  padding_right=8 \
  label.drawing=off

# Front App
sketchybar --add item front_app left \
  --set front_app icon.drawing=on \
  icon.font="SF Pro:Semibold:15.0" \
  icon.color=$ACCENT_QUATERNARY \
  icon.padding_left=6 \
  icon.padding_right=8 \
  label.font="SF Pro:Medium:13.0" \
  label.color=$WHITE \
  label.padding_left=4 \
  label.padding_right=8 \
  padding_left=8 \
  padding_right=8 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# YouTube Music (hidden while the app is not running, hence updates=on)
sketchybar --add item music left \
  --set music icon=􁁒 \
  drawing=off \
  updates=on \
  icon.padding_left=8 \
  icon.padding_right=2 \
  label.padding_right=8 \
  label.font="Hack Nerd Font:Bold:12.0" \
  label.align=left \
  label.max_chars=20 \
  update_freq=5 \
  script="$PLUGIN_DIR/youtube-music.sh" \
  background.color="$TRANSPARENT" \
  background.border_color="$TRANSPARENT" \
  scroll_texts=on \
  padding_right=0 \
  click_script="curl -s -m 2 -X POST 127.0.0.1:26538/api/v1/toggle-play; $PLUGIN_DIR/youtube-music.sh"

# YouTube Music album art
sketchybar --add item music-artwork left \
  --set music-artwork drawing=off \
  icon.drawing=off \
  label.drawing=off \
  width=20 \
  background.image.scale=0.09 \
  background.image.corner_radius=8 \
  background.image.drawing=on \
  background.color="$TRANSPARENT" \
  background.border_color="$TRANSPARENT" \
  padding_right=16 \
  click_script="curl -s -m 2 -X POST 127.0.0.1:26538/api/v1/toggle-play; $PLUGIN_DIR/youtube-music.sh"

##### Right Side Items #####

# Calendar Events
sketchybar --add item calendar right \
  --set calendar icon.font="SF Pro:Semibold:12.0" \
  icon.padding_left=8 \
  icon.padding_right=6 \
  label.font="SF Pro:Medium:12.0" \
  label.padding_left=4 \
  label.padding_right=8 \
  label.max_chars=28 \
  update_freq=900 \
  script="$PLUGIN_DIR/calendar.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  background.height=26 \
  padding_left=4 \
  padding_right=4 \
  --subscribe calendar system_woke

# Clock
sketchybar --add item clock right \
  --set clock icon="󰅐" \
  icon.font="SF Pro:Semibold:15.0" \
  icon.color=$YELLOW \
  icon.padding_left=8 \
  icon.padding_right=6 \
  label.font="SF Pro:Medium:13.0" \
  label.color=$WHITE \
  label.padding_left=4 \
  label.padding_right=8 \
  update_freq=10 \
  script="$PLUGIN_DIR/clock.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  click_script="sketchybar --set clock popup.drawing=toggle" \
  --subscribe clock system_woke mouse.exited.global

popup_item clock clock.full_date "󰸘" $YELLOW "" "open -a Calendar"
popup_item clock clock.week "󰸗" $BLUE "" "true"
popup_item clock clock.day_of_year "󰸙" $GREEN "" "true"

# WiFi Status
sketchybar --add item wifi right \
  --set wifi icon.font="SF Pro:Semibold:15.0" \
  icon.padding_left=8 \
  icon.padding_right=8 \
  label.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/wifi.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  --subscribe wifi wifi_change system_woke

# Bluetooth Status
sketchybar --add item bluetooth right \
  --set bluetooth icon.font="SF Pro:Semibold:15.0" \
  icon.padding_left=9 \
  icon.padding_right=9 \
  label.drawing=off \
  update_freq=60 \
  script="$PLUGIN_DIR/bluetooth.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  --subscribe bluetooth system_woke

# Input Source (event driven; the slow poll is only a safety net)
sketchybar --add item input_source right \
  --set input_source icon.font="SF Pro:Semibold:15.0" \
  icon.padding_left=8 \
  icon.padding_right=10 \
  label.drawing=off \
  update_freq=30 \
  script="$PLUGIN_DIR/get_input_source.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  --subscribe input_source input_change system_woke

# Volume (click: popup with mute toggle and slider)
sketchybar --add item volume right \
  --set volume icon.font="SF Pro:Semibold:15.0" \
  icon.color=$ACCENT_PRIMARY \
  icon.padding_left=10 \
  icon.padding_right=12 \
  label.drawing=off \
  script="$PLUGIN_DIR/volume.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  click_script="sketchybar --set volume popup.drawing=toggle" \
  popup.horizontal=on \
  --subscribe volume volume_change mouse.exited.global

sketchybar --add item volume.mute popup.volume \
  --set volume.mute icon="󰕾" \
  icon.color=$GREEN \
  label.drawing=off \
  background.drawing=off \
  padding_left=8 \
  padding_right=2 \
  click_script="osascript -e 'set volume output muted not (output muted of (get volume settings))'; sketchybar --trigger volume_change"

sketchybar --add slider volume.slider popup.volume 120 \
  --set volume.slider slider.highlight_color=$ACCENT_PRIMARY \
  slider.background.height=6 \
  slider.background.corner_radius=3 \
  slider.background.color=$BACKGROUND_2 \
  slider.knob.drawing=off \
  background.drawing=off \
  padding_left=4 \
  padding_right=4 \
  script="$PLUGIN_DIR/volume_slider.sh" \
  --subscribe volume.slider mouse.clicked

sketchybar --add item volume.percent popup.volume \
  --set volume.percent icon.drawing=off \
  label.font="SF Pro:Medium:11.0" \
  label.color=$WHITE \
  background.drawing=off \
  padding_left=2 \
  padding_right=8

# Battery
sketchybar --add item battery right \
  --set battery icon.font="SF Pro:Semibold:15.0" \
  icon.color=$ACCENT_SECONDARY \
  icon.padding_left=8 \
  icon.padding_right=6 \
  label.font="SF Pro:Medium:13.0" \
  label.color=$WHITE \
  label.padding_left=4 \
  label.padding_right=8 \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  --subscribe battery system_woke power_source_change

# Pritunl VPN
sketchybar --add item pritunl right \
  --set pritunl icon="􀤆" \
  icon.font="SF Pro:Semibold:13.0" \
  icon.color=$ACCENT_PRIMARY \
  icon.padding_left=8 \
  icon.padding_right=10 \
  label.drawing=off \
  background.color=$BACKGROUND_1 \
  background.drawing=on \
  padding_left=4 \
  padding_right=4 \
  click_script="open -a Pritunl"

##### Finalize Setup #####
sketchybar --update
