#!/bin/bash

# macOS version of ar/.config/bash/bashrc. Linux-only pieces (systemd, /proc,
# distro detection, GNU-only flags) are replaced with their macOS counterparts.
# Flags are kept to the ones BSD and GNU tools share, because the profile puts
# GNU coreutils first in PATH when it is installed.

[[ $- != *i* ]] && return

#######################################################
# SET OPTIONS
#######################################################
# history
HISTCONTROL=erasedups:ignoredups:ignorespace
HISTFILESIZE=10000
HISTSIZE=500

# Allow ctrl-S for history navigation (with ctrl-R)
stty -ixon
PROMPT_COMMAND="history -a"
unset GREP_OPTIONS

set -o vi
# autocd and direxpand need bash 4+; macOS ships 3.2 as /bin/bash.
shopt -s autocd 2>/dev/null    # goto without cd
shopt -s direxpand 2>/dev/null # expend directory name
shopt -s cdspell               # ignore case cd
shopt -s checkwinsize          # Check the window size after each command and, if necessary, update the values of LINES and COLUMNS
shopt -s histappend            # Causes bash to append to history instead of overwriting it so if you start a new terminal, you have old session history

# Completion settings
# Ignore case on auto-completion
# Note: bind used instead of sticking these in .inputrc
bind "set completion-ignore-case on"
# Show auto-completion list automatically, without double tab
bind "set show-all-if-ambiguous on"

