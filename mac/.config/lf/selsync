#!/bin/sh
# Persist the lf selection, sync it to other instances, and publish its total
# size to the ruler as the `user_selsize` option (see ~/.config/lf/ruler).
#
# WHY THIS IS A SCRIPT AND NOT INLINE lfrc SHELL
#
# lf (r42) deadlocks when its server socket is flooded. Every `lf -remote` is a
# round-trip through lf's server socket; when save-select fires one per
# keypress and <space> is held down, the server stops draining connections and
# the UI stops responding -- including to quit -- while `lf -remote` helpers
# pile up in the hundreds.
#
# The selection file is therefore written on every call -- that part is cheap
# and involves no IPC -- while everything that needs the server is deferred
# behind a debounce plus a single-flight lock. A burst of N toggles costs one
# broadcast instead of N.
#
# macOS port of ar/.config/lf/selsync: BSD stat and du, awk instead of
# numfmt(1), and perl's alarm instead of timeout(1).

set -u

sel="${XDG_DATA_HOME:-$HOME/.local/share}/lf/select"
run="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
lock="${run%/}/lf-selsync.lock"

# Coalescing window. Long enough to swallow held-key repeats, short enough that
# the ruler and other instances still feel immediate.
debounce=0.3

# Age in minutes after which a lock is assumed abandoned (its owner was killed
# before the trap could run) and is reclaimed by the next toggle.
stale_after=+1

mkdir -p "${sel%/*}" 2>/dev/null
printf '%s' "${fs-}" >"$sel"

if ! mkdir "$lock" 2>/dev/null; then
    [ -n "$(find "$lock" -maxdepth 0 -mmin "$stale_after" 2>/dev/null)" ] &&
        rmdir "$lock" 2>/dev/null
    exit 0
fi
trap 'rmdir "$lock" 2>/dev/null' EXIT HUP INT TERM

# Identity of the selection file, used to detect writes that landed while we
# were busy so the final published value is never stale.
stamp() {
    # /usr/bin/stat: the profile puts GNU coreutils first in PATH when it is
    # installed, and GNU stat has a different -f.
    /usr/bin/stat -f '%z:%Fm' "$sel" 2>/dev/null || printf 'none'
}

# A wedged lf must never leave the lock behind, hence the 5 second limit.
remote() {
    perl -e 'alarm shift; exec @ARGV' 5 lf -remote "$1" 2>/dev/null || true
}

# Total size of the selection in bytes (disk usage, as BSD du reports it).
total_size() {
    # awk, not `tr '\n' '\0'`: the selection file has no trailing newline, so tr
    # would hand xargs a final entry without its NUL terminator.
    awk '{ printf "%s%c", $0, 0 }' "$sel" |
        xargs -0 du -sk 2>/dev/null |
        awk '{ kb += $1 } END { if (NR) printf "%.0f", kb * 1024 }'
}

# 1536 -> 1.5K, like `numfmt --to=iec --format=%.1f`.
humanize() {
    awk -v b="$1" 'BEGIN {
        split("K M G T P", unit, " ")
        i = 0
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        if (i == 0) printf "%d", b
        else printf "%.1f%s", b, unit[i]
    }'
}

while :; do
    sleep "$debounce"
    before=$(stamp)

    # Pull the other instances onto the current selection.
    [ -n "${id-}" ] && remote "send load-select $id"

    if [ -s "$sel" ]; then
        total=$(total_size)
        [ -n "${total:-}" ] &&
            remote "send set user_selsize \"$(humanize "$total")\""
    else
        remote "send set user_selsize \"\""
    fi

    [ "$(stamp)" = "$before" ] && break
done
