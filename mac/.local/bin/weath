#!/bin/sh
#
# Get the weather on the terminal. You can pass an alternative location as a parameter,
# and/or use the 'cp' option to copy the forecast as plaintext to the clipboard.

weatherreport="${XDG_CACHE_HOME:-${HOME}/.cache}/weatherreport"

formats() {
  [ "$MANPAGER" = "less -s" ] && pager=true || pager=false
  [ "$pager" = "false" ] && {
    export MANPAGER='less -s'
    export LESS="R"
    export LESS_TERMCAP_mb="$(printf '%b' '[1;31m')"
    export LESS_TERMCAP_md="$(printf '%b' '[1;36m')"
    export LESS_TERMCAP_me="$(printf '%b' '[0m')"
    export LESS_TERMCAP_so="$(printf '%b' '[01;44;33m')"
    export LESS_TERMCAP_se="$(printf '%b' '[0m')"
    export LESS_TERMCAP_us="$(printf '%b' '[1;32m')"
    export LESS_TERMCAP_ue="$(printf '%b' '[0m')"
    export LESSOPEN="| /usr/bin/highlight -O ansi %s 2>/dev/null"
  }
  less -S "$1"
  [ "$pager" = "false" ] && {
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
  }
}

notify() {
  osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1
  printf '%s %s\n' "$1" "$2"
}

fail='Check your internet connection and the supplied location.'

if [ "$1" = 'cp' ]; then
  if [ -z "$2" ]; then
    # BSD sed has no \x escapes; match the literal ESC via a printf'd class.
    sed "s/$(printf '\033')\[[^m]*m//g" "$weatherreport" | pbcopy &&
      notify '🌞Weather forecast copied' "${LOCATION:-$(head -n 1 "$weatherreport" | cut -d' ' -f3-)}"
  else
    if data="$(curl -sfm 5 "${WTTRURL:-wttr.in}/$2?T")"; then
      printf '%s' "$data" | pbcopy
      notify '🌞Weather forecast copied' "$2"
    else
      notify '🥶Failed to get weather forecast!' "$fail"
    fi
  fi
else
  if [ -n "$2" ]; then
    notify '⛔Invalid option' "'$1'! The only valid option is 'cp'."
    exit 1
  fi

  if [ -z "$1" ]; then
    formats "$weatherreport"
  elif data="$(curl -sfm 5 "${WTTRURL:-wttr.in}/$1")"; then
    printf '%s' "$data" | formats -
  else
    notify '❗Failed to get weather forecast!' "$fail"
  fi
fi
