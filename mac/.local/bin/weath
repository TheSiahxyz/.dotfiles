#!/bin/sh
#
# Get the weather on the terminal. You can pass an alternative location as a parameter,
# and/or use the 'cp' option to copy the forecast as plaintext to the clipboard.

weatherreport="${XDG_CACHE_HOME:-${HOME}/.cache}/weatherreport"

# wttr.in draws a fixed 125-column layout, so only the height can be made to fit
# the window. The report is regular enough to trim by line count: a constant
# block on top (the "Weather report" line, a blank, and five lines of current
# conditions), then exactly ten lines per forecast day, then a footer whose
# "Location:" line is the only part worth keeping. Dropping whole days off the
# end is the only trim that leaves the tables intact.
headerlines=7
daylines=10
maxdays=3

# Print the report trimmed to the tallest whole number of days that fits on one
# screen.
fit() {
  rows="$(stty size 2>/dev/null </dev/tty | cut -d' ' -f1)"
  [ -n "$rows" ] || rows=24
  # less keeps the bottom line for its own prompt, and the appended "Location:"
  # line costs one more.
  days=$(((rows - 2 - headerlines) / daylines))
  [ "$days" -gt "$maxdays" ] && days="$maxdays"
  [ "$days" -lt 0 ] && days=0
  head -n $((headerlines + days * daylines)) "$1"
  grep -m1 '^Location:' "$1"
}

# Unlike the Linux variant this pages in the terminal it was launched from, so
# the size is already known and there is no second process to hand the trim to.
show() {
  LESS='R'
  LESSOPEN=''
  export LESS LESSOPEN
  fit "$1" | less -SR
}

# Download a report to a file rather than through a command substitution, which
# is not binary-safe in every /bin/sh: dash reserves byte 0x82 as an internal
# marker and escapes every occurrence, corrupting the U+2502 vertical bar that
# wttr.in draws its table borders with.
fetch() {
  curl -sfm 5 -o "$2" "${WTTRURL:-wttr.in}/$1"
}

scratch() {
  mktemp "${TMPDIR:-/tmp}/weath.XXXXXX"
}

notify() {
  osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1
  printf '%s %s\n' "$1" "$2"
}

fail='Check your internet connection and the supplied location.'

if [ "$1" = 'cp' ]; then
  if [ -z "$2" ]; then
    # BSD sed has no \x escapes; match the literal ESC via a printf'd class.
    sed "s/$(printf '\033')\[[^m]*m//g" "$weatherreport" | pbcopy &&
      notify '🌞Weather forecast copied' "${LOCATION:-$(head -n 1 "$weatherreport" | cut -d' ' -f3-)}"
  else
    tmp="$(scratch)"
    if fetch "$2?T" "$tmp"; then
      pbcopy <"$tmp"
      notify '🌞Weather forecast copied' "$2"
    else
      notify '🥶Failed to get weather forecast!' "$fail"
    fi
    rm -f "$tmp"
  fi
else
  if [ -n "$2" ]; then
    notify '⛔Invalid option' "'$1'! The only valid option is 'cp'."
    exit 1
  fi

  if [ -z "$1" ]; then
    show "$weatherreport"
  else
    tmp="$(scratch)"
    # Trap rather than a trailing rm, so a signal during paging still cleans up.
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    if fetch "$1" "$tmp"; then
      show "$tmp"
    else
      notify '❗Failed to get weather forecast!' "$fail"
    fi
  fi
fi
