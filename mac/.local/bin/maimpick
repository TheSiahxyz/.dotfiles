#!/bin/sh

# Choose the kind of screenshot to take, optionally copying it instead.

# variables
output_dir="${XDG_PICTURES_DIR:-${HOME}/Pictures}/screenshots/"
output="$(date '+%y%m%d-%H%M-%S').png"

[ -d "$output_dir" ] || mkdir -p "$output_dir"

options="a selected area
current window
full screen
a selected area (copy)
current window (copy)
full screen (copy)
copy selected image to text"

case "$(printf '%s\n' "$options" | fzf --layout=reverse --height 40% --prompt "Screenshot which area? ")" in
"a selected area") screencapture -i "$output_dir"pic-selected-"${output}" ;;
"current window") screencapture -o -w "$output_dir"pic-window-"${output}" ;;
"full screen") screencapture -T 1 "$output_dir"pic-full-"${output}" ;;
"a selected area (copy)") screencapture -i -c ;;
"current window (copy)") screencapture -o -w -c ;;
"full screen (copy)") screencapture -T 1 -c ;;
"copy selected image to text")
	command -v tesseract >/dev/null 2>&1 || {
		osascript -e 'display notification "tesseract must be installed for OCR." with title "📦 Dependency missing"'
		exit 1
	}
	tmpfile="$(mktemp -t ocr).png"
	trap 'rm -f "$tmpfile"' HUP INT QUIT TERM EXIT
	screencapture -i "$tmpfile" && tesseract "$tmpfile" - -l eng | pbcopy
	;;
esac
