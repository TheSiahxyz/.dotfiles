#!/bin/sh

bmdirs="${XDG_CONFIG_HOME:-${HOME}/.config}/shell/bm-dirs"
bmfiles="${XDG_CONFIG_HOME:-${HOME}/.config}/shell/bm-files"

# Output locations. Unactivated progs should go to /dev/null.
shell_shortcuts="${XDG_CONFIG_HOME:-${HOME}/.config}/shell/shortcutrc"
shell_env_shortcuts="${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutenvrc"
zsh_named_dirs="${XDG_CONFIG_HOME:-${HOME}/.config}/shell/zshnameddirrc"
out_if() {
  if command -v "$1" >/dev/null 2>&1 && [ -d "${2%/*}" ]; then
    printf '%s' "$2"
  else
    printf '/dev/null'
  fi
}

lf_shortcuts="$(out_if lf "${XDG_CONFIG_HOME:-${HOME}/.config}/lf/shortcutrc")"
vim_shortcuts="$(out_if vim "${XDG_CONFIG_HOME:-${HOME}/.config}/vim/shortcuts.vim")"
nvim_shortcuts="$(out_if nvim "${XDG_CONFIG_HOME:-${HOME}/.config}/nvim/shortcuts.lua")"
yazi_shortcuts="$(out_if yazi "${XDG_CONFIG_HOME:-${HOME}/.config}/yazi/keymap.toml")"
if [ "$yazi_shortcuts" = "/dev/null" ]; then
  yazi_shortcuts_tmp="/dev/null"
else
  yazi_shortcuts_tmp="$yazi_shortcuts.tmp"
fi
ranger_shortcuts="$(out_if ranger "${XDG_CONFIG_HOME:-${HOME}/.config}/ranger/shortcuts.conf")"
qute_shortcuts="$(out_if qutebrowser "$HOME/.qutebrowser/shortcuts.py")"
fish_shortcuts="$(out_if fish "${XDG_CONFIG_HOME:-${HOME}/.config}/fish/shortcuts.fish")"
vifm_shortcuts="$(out_if vifm "${XDG_CONFIG_HOME:-${HOME}/.config}/vifm/shortcuts.rc")"

# Remove, prepare files
for f in "$lf_shortcuts" "$ranger_shortcuts" "$qute_shortcuts" "$zsh_named_dirs" "$vim_shortcuts" "$nvim_shortcuts" "$yazi_shortcuts"; do
  [ "$f" = "/dev/null" ] || rm -f "$f" 2>/dev/null
done
printf "# vim: filetype=sh\\n" >"$fish_shortcuts"
printf "# vim: filetype=sh\\nalias " >"$shell_shortcuts"
printf "# vim: filetype=sh\\n" >"$shell_env_shortcuts"
printf "\" vim: filetype=vim\\n" >"$vifm_shortcuts"
[ -f "$HOME/.config/yazi/keymap-default.toml" ] && cp "$HOME/.config/yazi/keymap-default.toml" "$yazi_shortcuts"

# Format the `directories` file in the correct syntax and sent it to all three configs.
eval "echo \"$(cat "$bmdirs")\"" |
  awk "!/^\s*#/ && !/^\s*\$/ {gsub(\"\\\s*#.*$\",\"\");
    p=\$0; sub(/^[ \t]*[^ \t]+[ \t]+/,\"\",p); sub(/[ \t]+\$/,\"\",p);
    dq=sprintf(\"%c\",34); bs=sprintf(\"%c\",92); qp=dq p dq; eqp=bs dq p bs dq;
    vp=\"\"; rest=p; while((i=index(rest,\" \"))>0){ vp=vp substr(rest,1,i-1) bs \" \"; rest=substr(rest,i+1) } vp=vp rest;
    lvp=\"\"; rest=p; while((i=index(rest,\" \"))>0){ lvp=lvp substr(rest,1,i-1) bs bs \" \"; rest=substr(rest,i+1) } lvp=lvp rest;
    printf(\"%s=\42cd %s && ls -A\42 \\\\\n\",\$1,eqp)   >> \"$shell_shortcuts\" ;
    printf(\"[ -n \42%s\42 ] && export %s=\42%s\42 \n\",\$1,\$1,p)   >> \"$shell_env_shortcuts\" ;
    printf(\"hash -d %s=%s \n\",\$1,qp)                 >> \"$zsh_named_dirs\"  ;
    printf(\"abbr %s \42cd %s; and ls -A\42\n\",\$1,eqp) >> \"$fish_shortcuts\"  ;
    printf(\"map g%s :cd %s<CR>\nmap t%s <tab>:cd %s<CR><tab>\nmap M%s <tab>:cd %s<CR><tab>:mo<CR>\nmap Y%s <tab>:cd %s<CR><tab>:co<CR> \n\",\$1,qp, \$1, qp, \$1, qp, \$1, qp) >> \"$vifm_shortcuts\" ;
    printf(\"config.bind(',,%s', \42set downloads.location.directory %s ;; hint links download\42) \n\",\$1,eqp) >> \"$qute_shortcuts\" ;
    printf(\"map g%s cd %s\nmap t%s tab_new %s\nmap m%s shell mv -v %%s %s\nmap Y%s shell cp -rv %%s %s \n\",\$1,qp,\$1,qp, \$1, qp, \$1, qp) >> \"$ranger_shortcuts\" ;
    printf(\"map %s cd \42%s\42 \n\",\$1,p)           >> \"$lf_shortcuts\" ;
    printf(\"cmap ;%s %s\n\",\$1,vp)      >> \"$vim_shortcuts\" ;
    printf(\"nmap <localleader><localleader>%s :Explore %s<cr>\n\",\$1,vp)      >> \"$vim_shortcuts\" ;
    desc_path = p; gsub(\"^/home/$USER/\",\"~/\",desc_path);
    printf(\"vim.keymap.set('c', ';%s', '%s<cr>', { noremap = true, silent = true, desc = '%s' })\n\", \$1, lvp, desc_path) >> \"$nvim_shortcuts\" ;
    printf(\"vim.keymap.set('n', '<localleader><leader>%s', '<cmd>Explore %s<cr>', { noremap = true, silent = true, desc = '%s' })\n\", \$1, lvp, desc_path) >> \"$nvim_shortcuts\" ;
    printf(\"vim.keymap.set('n', '<localleader><localleader>%s', function() require('mini.files').open('%s') end, { noremap = true, silent = true, desc = '%s' })\n\", \$1, p, desc_path) >> \"$nvim_shortcuts\" ;
    desc_path = p; gsub(\"^/home/$USER/\",\"~/\",desc_path);
    key_array = \"\"; for(i=1; i<=length(\$1); i++) { if(i==1) key_array = \"\\\"\" substr(\$1,i,1) \"\\\"\"; else key_array = key_array \", \\\"\" substr(\$1,i,1) \"\\\"\" }
    printf(\"\\t{ on = [ %s ], run = \\\"cd %s\\\", desc = \\\"Go to %s\\\" },\\n\",key_array,p,desc_path) >> \"$yazi_shortcuts_tmp\"}"

# Format the `files` file in the correct syntax and sent it to both configs.
eval "echo \"$(cat "$bmfiles")\"" |
  awk "!/^\s*#/ && !/^\s*\$/ {gsub(\"\\\s*#.*$\",\"\");
    p=\$0; sub(/^[ \t]*[^ \t]+[ \t]+/,\"\",p); sub(/[ \t]+\$/,\"\",p);
    dq=sprintf(\"%c\",34); bs=sprintf(\"%c\",92); qp=dq p dq; eqp=bs dq p bs dq;
    vp=\"\"; rest=p; while((i=index(rest,\" \"))>0){ vp=vp substr(rest,1,i-1) bs \" \"; rest=substr(rest,i+1) } vp=vp rest;
    lvp=\"\"; rest=p; while((i=index(rest,\" \"))>0){ lvp=lvp substr(rest,1,i-1) bs bs \" \"; rest=substr(rest,i+1) } lvp=lvp rest;
    printf(\"%s=\42\$EDITOR %s\42 \\\\\n\",\$1,eqp)  >> \"$shell_shortcuts\" ;
    printf(\"[ -n \42%s\42 ] && export %s=\42%s\42 \n\",\$1,\$1,p)   >> \"$shell_env_shortcuts\" ;
    printf(\"v%s=\42\$EDITOR2 %s\42 \\\\\n\",\$1,eqp)  >> \"$shell_shortcuts\" ;
    printf(\"hash -d %s=%s \n\",\$1,qp)             >> \"$zsh_named_dirs\"  ;
    printf(\"abbr %s \42\$EDITOR %s\42 \n\",\$1,eqp) >> \"$fish_shortcuts\"  ;
    printf(\"abbr v%s \42\$EDITOR2 %s\42 \n\",\$1,eqp) >> \"$fish_shortcuts\"  ;
    printf(\"map %s :e %s<CR> \n\",\$1,qp)          >> \"$vifm_shortcuts\"  ;
    printf(\"map %s shell \$EDITOR %s \n\",\$1,qp)  >> \"$ranger_shortcuts\" ;
    printf(\"map v%s shell \$EDITOR2 %s \n\",\$1,qp)  >> \"$ranger_shortcuts\" ;
    printf(\"map %s \$\$EDITOR \42%s\42 \n\",\$1,p)   >> \"$lf_shortcuts\" ;
    printf(\"map v%s \$\$EDITOR2 \42%s\42 \n\",\$1,p)   >> \"$lf_shortcuts\" ;
    printf(\"cmap ;%s %s\n\",\$1,vp)        >> \"$vim_shortcuts\" ;
    printf(\"nmap <localleader><localleader>%s :e %s<cr>\n\",\$1,vp)        >> \"$vim_shortcuts\" ;
    desc_path = p; gsub(\"^/home/$USER/\",\"~/\",desc_path);
    printf(\"vim.keymap.set('c', ';%s', '%s<cr>', { noremap = true, silent = true, desc = '%s' })\n\", \$1, lvp, desc_path) >> \"$nvim_shortcuts\" ;
    printf(\"vim.keymap.set('n', '<localleader><localleader>%s', '<cmd>e %s<cr>', { noremap = true, silent = true, desc = '%s' })\n\", \$1, lvp, desc_path) >> \"$nvim_shortcuts\" ;
    desc_path = p; gsub(\"^/home/$USER/\",\"~/\",desc_path);
    key_array = \"\"; for(i=1; i<=length(\$1); i++) { if(i==1) key_array = \"\\\"\" substr(\$1,i,1) \"\\\"\"; else key_array = key_array \", \\\"\" substr(\$1,i,1) \"\\\"\" }
    printf(\"\\t{ on = [ %s ], run = [ 'reveal %s', 'open' ], desc = \\\"Open %s\\\" },\\n\", key_array, p, desc_path) >> \"$yazi_shortcuts_tmp\" }"

# Merge bookmarks into keymap-default.toml
if [ -f "$yazi_shortcuts_tmp" ]; then
  # Find the line with the closing bracket in the [mgr] section
  line_num=$(grep -n "^]" "$yazi_shortcuts" | head -1 | cut -d: -f1)

  # Create the merged file
  head -n $((line_num - 1)) "$yazi_shortcuts" >"$yazi_shortcuts.new"
  echo "" >>"$yazi_shortcuts.new"
  echo "	# Custom bookmarks" >>"$yazi_shortcuts.new"
  cat "$yazi_shortcuts_tmp" >>"$yazi_shortcuts.new"
  echo "]" >>"$yazi_shortcuts.new"
  tail -n +$((line_num + 1)) "$yazi_shortcuts" >>"$yazi_shortcuts.new"

  # Replace the original file
  mv "$yazi_shortcuts.new" "$yazi_shortcuts"
  rm -f "$yazi_shortcuts_tmp"
fi

