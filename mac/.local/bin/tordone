#!/bin/sh

completed_torrents=$(transmission-remote -n "$USER" -l | grep 100% | awk '{print $1}')
if [ -n "$completed_torrents" ]; then
  for torrent_id in $completed_torrents; do
    transmission-remote -n "$USER" -t "$torrent_id" -r
  done
  osascript -e "display notification \"Torrent(s) $TR_TORRENT_NAME has completed downloading. Deleting torrent files.\" with title \"✅ Transmission-daemon\""
  [ -z "$(transmission-remote -n "$USER" -l | grep -v "Sum:")" ] && killall transmission-daemon && osascript -e "display notification \"❌ Transmission-daemon disabled.\" with title \"dotfiles\""
fi
