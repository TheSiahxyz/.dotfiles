#!/bin/sh

# Get a one-time password, or add a OTP secret to your pass-otp store.

# The assumption of this script is that all otp passwords are stored with the
# suffix `-otp`. This script automatically appends newly added otps as such.

# For OTP passwords to be generated properly, it is important for the local
# computer to have its time properly synced.

ifinstalled pass pass-otp || exit 1

notify() {
	osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1
}

dir="${PASSWORD_STORE_DIR}"

choice="$({
	echo "🆕add"
	echo "🕙sync-time"
	find "$dir" -type f -iname '*-otp.gpg'
} | sed "s/.*\///;s/-otp.gpg//" | fzf --layout=reverse --height 40% --prompt "Pick a 2FA: ")"

case $choice in
"") exit 0 ;;
🆕add)
	ifinstalled zbar || exit 1

	temp="$(mktemp -t otpqr).png"
	otp="otp-test-script"
	# no shred(1) on macOS; rm -P overwrites before unlinking.
	trap 'rm -Pf "$temp"; pass rm -f $otp' HUP INT QUIT TERM EXIT

	notify "Scan the image." "Scan the OTP QR code."

	screencapture -i "$temp" || exit 1
	info="$(zbarimg -q "$temp")"
	info="${info#QR-Code:}"

	if echo "$info" | pass otp insert "$otp"; then
		while true; do
			printf 'Give this One Time Password a one-word name: ' >&2
			read -r name || exit 1
			[ -z "$name" ] && exit 0
			echo "$name" | grep -q -- "^[A-z0-9-]\+$" && break
		done
		pass mv "$otp" "$name-otp"
		notify "Successfully added." "$name-otp has been created."
	else
		notify "No OTP data found." "Try to scan the image again more precisely."
	fi
	;;
🕙sync-time)
	notify "🕙 Synchronizing Time..." "Synching time with remote NTP servers..."
	sudo sntp -sS pool.ntp.org &&
		notify "🕙 Synchronizing Time..." "Done."
	;;
*) pass otp -c "${choice}"-otp ;;
esac
