#!/bin/sh

ext="${1##*.}"
mpvfiles="avi flv mkv mov mpeg mpg mp4 rmvb webm wmv w3m ogv ts 3gp"
imagefiles="png jpg jpeg jpe gif bmp tiff tif"
dlfiles="mp3 flac opus wav aac wma m4a mp3?source=feed"

if echo "$mpvfiles" | grep -qw "$ext"; then
  nohup mpv --loop --quiet "$1" >/dev/null 2>&1 &
elif echo "$imagefiles" | grep -qw "$ext"; then
  open "$1" >/dev/null 2>&1 &
elif echo "$dlfiles" | grep -qw "$ext"; then
  (cd "${XDG_DOWNLOAD_DIR:-${HOME}/Downloads}" && curl -sLO "$1") >/dev/null 2>&1 &
else
  # BROWSER is "open -a Firefox", so it must stay unquoted to word-split.
  # shellcheck disable=SC2086
  nohup ${BROWSER:-open} "$1" >/dev/null 2>&1 &
fi
