#!/bin/sh

# Keeps yt-dlp current, meant to be run as a cronjob. Rate-limited to once a day.

# macOS cron runs with a minimal PATH, so Homebrew is not reachable by default.
[ -x /opt/homebrew/bin/brew ] && PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
[ -x /usr/local/bin/brew ] && PATH="/usr/local/bin:/usr/local/sbin:$PATH"
export PATH

timestamp_file="${XDG_CACHE_HOME:-${HOME}/.cache}/ytdlpupdate"
current_time=$(date +%s)

mkdir -p "$(dirname "$timestamp_file")"

# Skip if the last successful run was less than 24 hours ago
if [ -f "$timestamp_file" ] && [ "$(cat "$timestamp_file")" -gt "$((current_time - 86400))" ]; then
  exit 0
fi

command -v brew >/dev/null 2>&1 || exit 1

brew update --quiet || exit 1

if brew list --formula yt-dlp >/dev/null 2>&1; then
  brew upgrade --formula yt-dlp || exit 1
else
  brew install --formula yt-dlp || exit 1
fi

echo "$current_time" >"$timestamp_file"
