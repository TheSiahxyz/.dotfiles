#!/bin/sh

# Toggles all cronjobs off/on.
# Stores disabled crontabs in ~/.config/crons until restored.

cron_file="${XDG_CONFIG_HOME:-${HOME}/.config}/crons"

notify() {
  osascript -e "display notification \"$1\" with title \"dotfiles\"" >/dev/null 2>&1
}

# Check if there are any active cronjobs
if crontab -l 2>/dev/null | grep -qv '^#\|^$'; then
  # If active cronjobs are found, save them off before disabling. Never remove
  # the crontab unless the save succeeded, or the jobs are gone for good.
  mkdir -p "$(dirname "$cron_file")"
  if ! crontab -l >"$cron_file" 2>/dev/null; then
    rm -f "$cron_file"
    notify "⛔ Could not save cronjobs. Nothing was disabled."
    exit 1
  fi
  crontab -r
  notify "⏰ Cronjobs saved and disabled."
elif [ -f "$cron_file" ]; then
  # If no active cronjobs are found, try re-enabling from the saved file
  crontab "$cron_file" && rm -f "$cron_file"
  notify "🕓 Cronjobs re-enabled."
else
  notify "🕰️ No saved cronjobs to re-enable."
fi
